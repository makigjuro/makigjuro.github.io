---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { minutes?: number };

const { title, description, pubDate, updatedDate, heroImage, tags = [], minutes } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a class="back" href="/blog">← all notes</a>
				<header class="title">
					{tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => <span class="tag">{t}</span>)}
						</div>
					)}
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<p class="meta">
						<FormattedDate date={pubDate} />
						{minutes && <> · {minutes} min read</>}
						{updatedDate && (
							<>
								{' '}· Updated <FormattedDate date={updatedDate} />
							</>
						)}
					</p>
				</header>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	.back {
		font-family: var(--font-mono);
		display: inline-block;
		margin-bottom: 2em;
		font-size: 0.85em;
		font-weight: 500;
		color: var(--muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--accent);
	}
	.title {
		margin-bottom: 2.5em;
		padding-bottom: 2em;
		border-bottom: 1px solid var(--line);
	}
	.tags {
		display: flex;
		gap: 0.35em;
		margin-bottom: 1em;
	}
	.title h1 {
		font-size: 2.4em;
		line-height: 1.12;
		letter-spacing: -0.03em;
	}
	.description {
		font-size: 1.1em;
		color: var(--muted);
	}
	.meta {
		margin: 0;
		font-size: 0.82em;
		color: var(--muted);
	}
	.hero-image {
		margin-bottom: 2.5em;
	}
	.prose :global(h2) {
		margin-top: 2em;
		font-size: 1.45em;
	}
	.prose :global(h3) {
		margin-top: 1.6em;
		font-size: 1.15em;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1.25em;
	}
	.prose :global(li) {
		margin-bottom: 0.35em;
	}
	.prose :global(pre) {
		margin: 0 0 1.5em;
		border: 1px solid #1d2638;
	}
	@media (max-width: 560px) {
		.title h1 {
			font-size: 1.9em;
		}
	}
</style>
