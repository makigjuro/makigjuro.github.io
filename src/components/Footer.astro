---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="sign">
			<span class="accent">$</span> echo "thanks for reading"
		</p>
		<nav aria-label="Footer">
			<a href="/blog">notes</a>
			<a href="/about">about</a>
			<a href="/rss.xml">rss</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener">github</a>
			<a href={LINKEDIN_URL} target="_blank" rel="noopener">linkedin</a>
		</nav>
		<p class="copy">&copy; {today.getFullYear()} Marjan Gjuroski · opinions are my own</p>
	</div>
</footer>
<style>
	footer {
		margin-top: 5em;
		border-top: 1px solid var(--line);
		background: var(--surface-2);
	}
	.inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.75em 2em;
		max-width: var(--max);
		margin: 0 auto;
		padding: 2.5em 16px;
		font-family: var(--font-mono);
		font-size: 0.8em;
		color: var(--muted);
	}
	p {
		margin: 0;
	}
	.sign {
		color: var(--ink);
	}
	.accent {
		color: var(--accent);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
		grid-row: span 2;
		align-self: center;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.inner {
			grid-template-columns: 1fr;
		}
		nav {
			grid-row: auto;
		}
	}
</style>
