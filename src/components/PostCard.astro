---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../utils/readingTime';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
const isoDate = pubDate.toISOString().slice(0, 10);
---

<li>
	<a class="row" href={`/blog/${post.id}/`}>
		<time datetime={pubDate.toISOString()}>{isoDate}</time>
		<div class="body">
			<h3>
				{title}
				{draft && <span class="draft">draft</span>}
			</h3>
			<p>{description}</p>
			<div class="meta">
				{tags.map((t) => <span class="tag">{t}</span>)}
				<span class="read">{readingTime(post.body)} min</span>
			</div>
		</div>
	</a>
</li>
<style>
	li {
		list-style: none;
		border-top: 1px solid var(--line);
	}
	li:last-child {
		border-bottom: 1px solid var(--line);
	}
	.row {
		display: grid;
		grid-template-columns: 8em 1fr;
		gap: 1.5em;
		padding: 1.4em 0.75em;
		margin: 0 -0.75em;
		border-radius: var(--radius);
		color: var(--text);
		text-decoration: none;
		transition: background 0.15s ease;
	}
	.row:hover {
		background: var(--surface-2);
		color: var(--text);
	}
	time {
		padding-top: 0.2em;
		font-family: var(--font-mono);
		font-size: 0.8em;
		color: var(--muted);
	}
	h3 {
		margin: 0 0 0.3em;
		font-size: 1.12em;
		line-height: 1.35;
	}
	.row:hover h3 {
		color: var(--accent);
	}
	p {
		margin: 0 0 0.7em;
		font-size: 0.92em;
		line-height: 1.6;
		color: var(--muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4em;
	}
	.read {
		margin-left: 0.3em;
		font-family: var(--font-mono);
		font-size: 0.72em;
		color: var(--muted);
	}
	.draft {
		margin-left: 0.4em;
		padding: 0.1em 0.45em;
		font-family: var(--font-mono);
		font-size: 0.6em;
		font-weight: 400;
		vertical-align: middle;
		border: 1px dashed #c9a25a;
		border-radius: 4px;
		color: #8a5a00;
	}
	@media (max-width: 560px) {
		.row {
			grid-template-columns: 1fr;
			gap: 0.3em;
		}
	}
</style>
